                </ul>
              </div>
            </div>
          </div>

          <!-- Social Media Links -->
          <div class="col-lg-3 p-4">
            <h5 class="fw-bold mb-3">Connect With Us</h5>
            <div class="d-flex gap-3">
              <a href="https://x.com/haveibeenpwned" target="_blank" class="text-muted hover-white fs-5"><i class="bi bi-twitter-x"></i></a>
