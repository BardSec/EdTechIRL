<main>
  <section class="py-5 bg-dark-subtle-custom">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-center">
        <h1 class="fw-bold mb-4">Sign In to Your Dashboard</h1>
        <p class="lead text-muted mb-0">Access personalised features and manage your Have I Been Pwned account</p>
      </div>
    </div>
  </div>
</section>

  <section class="py-5" id="verificationSection">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-6 mx-auto">
          <div class="card card-glow mb-4">
            <div class="card-body p-4">
              <h3 class="fw-bold mb-3">Sign In to Your Dashboard</h3>
              <p class="mb-4">
                Your dashboard is where you can access features that require you to identify yourself first, including:
              </p>
              <ul class="list-unstyled mb-4">
                <li class="d-flex align-items-start mb-3">
                  <i class="bi bi-shield-lock text-primary me-2 fs-5"></i>
                  <div>
                    Searching for your email address in sensitive breaches
                  </div>
                </li>
                <li class="d-flex align-items-start mb-3">
                  <i class="bi bi-binoculars text-primary me-2 fs-5"></i>
                  <div>
                    Viewing stealer log entries that captured your email address
                  </div>
                </li>
                <li class="d-flex align-items-start mb-3">
                  <i class="bi bi-globe text-primary me-2 fs-5"></i>
                  <div>Adding and searching domains you own</div>
                </li>
                <li class="d-flex align-items-start mb-3">
                  <i class="bi bi-key text-primary me-2 fs-5"></i>
                  <div>
                    Purchasing and managing API keys and paid subscriptions
                  </div>
                </li>
              </ul>

              <div id="signInForm">
                <div class="row g-3 mb-4">
                  <div class="col-12 col-md-6" id="emailSignInOption">
                    <button type="button" class="wizard-option-card w-100 h-100 text-start p-3 d-flex align-items-start" id="emailSignInRevealButton">
                      <div class="d-flex align-items-start">
                        <i class="bi bi-envelope fs-4 text-primary me-3 mt-1"></i>
                        <div>
                          <div class="fw-bold mb-1">Sign In with Email</div>
                          <small class="text-muted">Get a verification link sent to your inbox.</small>
                        </div>
                      </div>
                    </button>
                  </div>

                    <div class="col-12 col-md-6">
                      <button type="button" class="wizard-option-card w-100 h-100 text-start p-3 d-flex align-items-start" id="passkeySignInButton">
                        <div class="d-flex align-items-start">
                          <i class="bi bi-fingerprint fs-4 text-primary me-3 mt-1"></i>
                          <div>
                            <div class="fw-bold mb-1">Sign In with Passkey</div>
                            <small class="text-muted">Use a passkey already associated with your dashboard.</small>
                          </div>
                        </div>
                      </button>
                    </div>
                </div>

                <div class="collapse" id="emailSignInCollapse">
                  <p class="text-muted mb-3">Enter your address to begin signing in:</p>
                  <form id="dashboardVerificationForm">
                    <div class="mb-3">
                      <div class="input-group-custom">
                        <input type="email" class="form-control" id="emailInput" placeholder="Your email address" autocomplete="username webauthn" data-val="true" data-val-maxlength="The field Account must be a string or array type with a maximum length of &#x27;255&#x27;." data-val-maxlength-max="255" data-val-minlength="The field Account must be a string or array type with a minimum length of &#x27;3&#x27;." data-val-minlength-min="3" maxlength="255" name="AccountCheck.Account" value="" />
                        <input type="hidden" name="returnUrl" id="returnUrl" value="/Dashboard" />
                        <div class="btn-container">
                          <button type="submit" class="btn btn-primary px-5" id="signInButton" data-bs-toggle="loading-button" data-bs-disable-button="true">
                            <span class="btn-text">Sign In</span>
                          </button>
                        </div>
                      </div>
                      <div>
                        <div class="input-group-custom pt-2">
                          <p class="text-muted mb-3 d-none" id="turnstileBlock">Please check the box below to prove you aren't a bot :)</p>
                        </div>
                        <div class="input-group-custom">
                          <div id="turnstileSignIn" class="cf-turnstile"></div>
                        </div>
                      </div>
                    </div>
                    <div class="form-text">
                      We'll send a verification link to this address. Signing in does not create an
                      account or permanently store your email address, it simply shows you data that
                      already exists in HIBP.
                    </div>
                  </form>
                </div>
              </div>

              <div id="successMessage" class="alert alert-success mt-4 d-none" role="alert">
                <div class="d-flex align-items-start">
                  <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                  <div>
                    <strong>Verification sent!</strong> Check
                    your inbox for a link to your dashboard.
                    If you don't see the email, check your spam folder.
                  </div>
                </div>
              </div>

              <div id="errorMessage" class="alert alert-danger mt-4 d-none" role="alert">
                <div class="d-flex align-items-start">
                  <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                  <div>
                    <strong>Verification failed!</strong>
                    <br />
                    <span id="errorMessageText"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>


