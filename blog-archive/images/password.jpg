    <!-- Password Table 2026 — paste into Squarespace Code block (HTML). Static cite works without JS. -->
<div class="passwordtable-cite-box" style="background-color:#f8f9fa;border:1px solid #dee2e6;border-radius:8px;padding:20px;margin:24px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;">
