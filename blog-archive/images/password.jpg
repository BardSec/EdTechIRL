<script>
(function() {
  function initSticky() {
    let stickyStarts = document.querySelectorAll('.sticky-column');

    stickyStarts.forEach(el => {
      let col = el.closest('.col');
      if (!col) return;
      col.classList.add('sticky-column');
    });
  }

  window.addEventListener('DOMContentLoaded', initSticky);
}());
</script>
  
  



