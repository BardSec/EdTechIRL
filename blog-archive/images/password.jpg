          <div class="blog-item-injection"><script>
document.addEventListener('DOMContentLoaded', function () {
  var content = document.querySelector('.blog-item-content') || document.querySelector('article.hentry');
  var readingEl = document.querySelector('.reading-time');
  if (!content || !readingEl) return;
  var wordCount = content.textContent
    .replace(/[^\w ]/g, '')
    .split(/\s+/)
    .filter(Boolean).length;
  var minutes = Math.floor(wordCount / 200) + 1;
  readingEl.textContent = minutes + ' min';
});
</script>

