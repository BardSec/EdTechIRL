<script defer>
  document.addEventListener("contextmenu", e => e.preventDefault(), false);
  document.addEventListener("keydown", e => {
    const isMac = /Mac/.test(navigator.platform);
    if ((isMac ? e.metaKey : e.ctrlKey) && e.key.toLowerCase() === "s") e.preventDefault();     /* Ctrl/Cmd+S */
    if (e.ctrlKey && e.shiftKey && (e.key.toLowerCase() === "i" || e.key.toLowerCase() === "j")) e.preventDefault();
    if ((isMac ? e.metaKey : e.ctrlKey) && e.key.toLowerCase() === "u") e.preventDefault();
    if (e.key === "F12") e.preventDefault();
  }, false);
